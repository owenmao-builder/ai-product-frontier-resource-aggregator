{
  "name": "ai-product-frontier-resource-aggregator",
  "version": "1.5.0",
  "description": "Curates important AI technology and product updates using novelty, impact, explanatory value, and decision relevance, with key insights in the macOS menu bar.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "fetch": "tsx src/index.ts",
    "fetch:dev": "tsx watch src/index.ts",
    "fetch:opml": "tsx src/test-opml.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:macos": "bash macos/test.sh"
  },
  "keywords": [
    "ai",
    "news",
    "macos",
    "menu-bar",
    "rss",
    "ai-products",
    "evidence-based",
    "swiftui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "fast-xml-parser": "^4.5.0",
    "p-limit": "^6.1.0",
    "rss-parser": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/xml2js": "^0.4.14",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/owenmao-builder/ai-product-frontier-resource-aggregator",
  "repository": {
    "type": "git",
    "url": "https://github.com/owenmao-builder/ai-product-frontier-resource-aggregator.git"
  },
  "bugs": {
    "url": "https://github.com/owenmao-builder/ai-product-frontier-resource-aggregator/issues"
  },
  "author": "Owen Mao (https://github.com/owenmao-builder)",
  "packageManager": "pnpm@7.33.7"
}
